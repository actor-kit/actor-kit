{
  "name": "@actor-kit/studio-cli",
  "version": "0.3.0-next.0",
  "description": "Read-only CLI and MCP server for Actor Kit Studio (inspect, timeline, view) behind Cloudflare Access",
  "type": "module",
  "bin": {
    "actor-kit": "./dist/bin.js",
    "actor-kit-studio-mcp": "./dist/mcp-bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "license": "MIT",
  "author": "Jonathan Mumm",
  "repository": {
    "type": "git",
    "url": "https://github.com/actor-kit/actor-kit.git",
    "directory": "packages/studio-cli"
  },
  "homepage": "https://actorkit.dev",
  "keywords": [
    "actor",
    "cloudflare",
    "durable-objects",
    "devtools",
    "studio",
    "mcp",
    "cli"
  ],
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ]
