    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.166.7",
    "@vitejs/plugin-react": "^5.1.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.1"
  },
  "license": "MIT",
  "author": "Jonathan Mumm",
