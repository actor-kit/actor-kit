{
  "name": "actor-kit-2-root",
  "private": true,
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "test:unit": "vitest run",
    "test:integration": "pnpm build && pnpm --filter @actor-kit/integration-tests test",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:e2e": "pnpm build && pnpm exec playwright test",
    "lint": "biome check packages/core/src/ packages/worker/src/ packages/client/src/ packages/react/src/ packages/test/src/ packages/studio/src/ tests/",
    "lint:fix": "biome check --write packages/core/src/ packages/worker/src/ packages/client/src/ packages/react/src/ packages/test/src/ packages/studio/src/ tests/",
    "build": "pnpm -r run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@cloudflare/workers-types": "^5.20260927.1",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "immer": "^11.1.18",
    "jose": "^6.2.12",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
