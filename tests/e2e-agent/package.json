{
  "name": "@actor-kit/e2e-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "pnpm test:e2e:studio; s=$?; pnpm test:e2e:chat-room && exit $s",
    "test:e2e:studio": "e2e run --target studio tests/studio",
    "test:e2e:chat-room": "e2e run --target chat-room tests/chat-room"
  },
  "devDependencies": {
    "@e2e-dev/web": "^0.13.0",
    "@types/node": "^26.6.4",
    "e2e": "^0.18.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  }
}
