{
  "name": "actor-kit-todo-example",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "pnpm build && wrangler dev -c .output/server/wrangler.json --persist-to .wrangler/state --port 8800 --inspector-port 0",
