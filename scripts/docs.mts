/**
 * Docs that ship with the code (ADR-018 H). One source, the website's markdown, becomes:
 *
 * - website/src/content/docs/errors/<code>.md: a page per error code, from ERROR_CODES in
 *   @actor-kit/core, so every `docs` URL an error or refusal carries resolves;
 * - packages/<pkg>/docs/*.md: the pages each package's users need, with site links made absolute
 *   (published with the package: `docs` is in its package.json `files`);
 * - llms.txt (an index) and llms-full.txt (every page in one file), at the repo root and in
 *   website/public, so the site serves them at https://actorkit.dev/llms.txt.
 *
 * `generateDocs()` returns every file as path → content; scripts/gen-docs.mts writes them and
 * tests/unit/docs-generated.test.ts checks they are up to date.
 */

import { readFileSync } from "node:fs";
import { join } from "node:path";
import { ERROR_CODE_LIST, ERROR_CODES, type ErrorCode, REFUSAL_CODES } from "../packages/core/src/errors.ts";

export const SITE = "https://actorkit.dev";
const DOCS = "website/src/content/docs";
const GENERATED =
  "<!-- Generated by scripts/gen-docs.mts from the website's docs. Do not edit: run `pnpm docs:gen`. -->";

/** The website's pages in the sidebar's order, by section (slug without the trailing slash). */
export const SECTIONS: ReadonlyArray<{ title: string; slugs: readonly string[] }> = [
  {
    title: "Getting started",
    slugs: ["getting-started/overview", "getting-started/installation", "getting-started/quick-start"],
  },
  { title: "Examples", slugs: ["examples/counter", "examples/todo-list", "examples/chat-room", "examples/auction"] },
  {
    title: "Concepts",
    slugs: [
      "concepts/actors-and-state",
      "concepts/authentication",
      "concepts/roles-and-authorization",
      "concepts/messages-and-guards",
      "concepts/views",
      "concepts/binary-sync",
      "concepts/side-effects",
      "concepts/timers",
      "concepts/domain-events",
      "concepts/states",
      "concepts/testing",
      "concepts/scalability",
    ],
  },
  {
    title: "Recipes",
    slugs: [
      "recipes/actor-to-actor",
      "recipes/scaling-with-relays",
      "recipes/testing-side-effects",
      "recipes/storybook",
    ],
  },
  { title: "Studio", slugs: ["studio/overview", "studio/setup"] },
  { title: "FAQ", slugs: ["faq"] },
  { title: "API reference", slugs: ["api/core", "api/client", "api/react", "api/test", "api/storybook", "api/studio"] },
];

/** The pages each package ships in its docs/ folder (`errors` is the generated error reference). */
export const PACKAGE_DOCS: Readonly<Record<string, readonly string[]>> = {
  core: ["api/core", "concepts/views", "concepts/binary-sync", "errors"],
  worker: [
    "getting-started/quick-start",
    "concepts/actors-and-state",
    "concepts/authentication",
    "concepts/roles-and-authorization",
    "concepts/messages-and-guards",
    "concepts/views",
    "concepts/side-effects",
    "concepts/timers",
    "concepts/domain-events",
    "concepts/states",
    "recipes/actor-to-actor",
    "recipes/scaling-with-relays",
    "api/core",
    "upgrading-0.3",
    "errors",
  ],
  client: ["api/client", "concepts/binary-sync", "errors"],
  react: ["api/react", "api/client"],
  test: ["api/test", "concepts/testing", "recipes/testing-side-effects", "errors"],
  storybook: ["api/storybook", "recipes/storybook"],
  studio: ["studio/overview", "studio/setup", "api/studio"],
  "studio-cli": ["studio/overview", "studio/setup"],
};

interface Page {
  readonly slug: string;
  readonly title: string;
  readonly description: string;
  readonly body: string;
}

function unquote(value: string): string {
  const trimmed = value.trim();
  return /^".*"$/.test(trimmed) ? trimmed.slice(1, -1).replace(/\\"/g, '"') : trimmed;
}

/** A markdown page split into its frontmatter title/description and its body. */
export function parsePage(slug: string, text: string): Page {
  const match = /^---\n([\s\S]*?)\n---\n?([\s\S]*)$/.exec(text);
  if (match === null) throw new Error(`${slug}: no frontmatter`);
  const [, front = "", body = ""] = match;
  const field = (name: string) => {
    const line = front.split("\n").find((l) => l.startsWith(`${name}:`));
    return line === undefined ? "" : unquote(line.slice(name.length + 1));
  };
  return { slug, title: field("title"), description: field("description"), body: body.trim() };
}

/** Site-relative links (`](/concepts/states/)`) made absolute, for docs read outside the site. */
export function absoluteLinks(markdown: string): string {
  return markdown.replace(/\]\(\/(?!\/)/g, `](${SITE}/`);
}

function url(slug: string): string {
  return `${SITE}/${slug}/`;
}

function readPage(root: string, slug: string): Page {
  return parsePage(slug, readFileSync(join(root, DOCS, `${slug}.md`), "utf8"));
}

/** The page for one error code: what it means, how to fix it, and how it reaches you. */
export function errorPage(code: ErrorCode): string {
  const info = ERROR_CODES[code];
  const refusal = REFUSAL_CODES.some((c) => c === code);
  const how = refusal
    ? "Returned (not thrown) as a refusal: `{ ok: false, code, message, expected?, details?, docs }` from `send()`, `simulate().send` and the WebSocket `__error` frame; thrown by `testActor` as a `RefusalError`."
    : "Thrown as an `ActorKitError` (or a subclass) whose `code` is this one and whose `docs` is this page.";
  return [
    "---",
    `title: ${JSON.stringify(code)}`,
    `description: ${JSON.stringify(info.title)}`,
    "---",
    "",
    GENERATED,
    "",
    `**What happened:** ${info.title}`,
    "",
    `**How to fix it:** ${info.fix}`,
    "",
    how,
    "",
    "The error's `message` names the specifics (the message, state, binding or value involved). See all [error codes](/errors/).",
    "",
  ].join("\n");
}

function errorsIndex(): string {
  const rows = Object.entries(ERROR_CODES).map(([code, info]) => `| [\`${code}\`](/errors/${code}/) | ${info.title} |`);
  return [
    "---",
    'title: "Error codes"',
    "description: Every code an actor-kit error or refusal carries, what it means and how to fix it.",
    "---",
    "",
    GENERATED,
    "",
    "Every error actor-kit throws is an `ActorKitError` with a stable `code` and a `docs` URL pointing here; every refused message is a `Refusal` with the same. Match on `code`, never on message text.",
    "",
    "| Code | Meaning |",
    "|---|---|",
    ...rows,
    "",
  ].join("\n");
}

/** One error-reference markdown file (for package docs and llms-full.txt). */
function errorsReference(): string {
  const sections = Object.entries(ERROR_CODES).map(
    ([code, info]) =>
      `## \`${code}\`\n\n**What happened:** ${info.title}\n\n**How to fix it:** ${info.fix}\n\nDocs: ${url(`errors/${code}`)}`,
  );
  return ["# Error codes", "", GENERATED, "", ...sections.flatMap((s) => [s, ""])].join("\n");
}

function packageDoc(root: string, slug: string): string {
  if (slug === "errors") return errorsReference();
  if (slug === "upgrading-0.3")
    return `${GENERATED}\n\n${absoluteLinks(readFileSync(join(root, "docs/upgrading-0.3.md"), "utf8").trim())}\n`;
  const page = readPage(root, slug);
  return `# ${page.title}\n\n${GENERATED}\n\nOnline: ${url(slug)}\n\n${absoluteLinks(page.body)}\n`;
}

function fileName(slug: string): string {
  return `${slug.replace(/\//g, "-")}.md`;
}

function packageIndex(pkg: string, slugs: readonly string[], root: string): string {
  const lines = slugs.map((slug) => {
    if (slug === "errors")
      return `- [Error codes](${fileName(slug)}): every error and refusal code, what it means, how to fix it.`;
    if (slug === "upgrading-0.3")
      return `- [Upgrading to 0.3](${fileName(slug)}): one note per breaking change, with code before and after.`;
    const page = readPage(root, slug);
    return `- [${page.title}](${fileName(slug)}): ${page.description}`;
  });
  return [
    `# @actor-kit/${pkg} docs`,
    "",
    GENERATED,
    "",
    "These pages ship with the package so they match the version you installed. The whole site is at",
    `${SITE}; agents can read ${SITE}/llms.txt (an index) or ${SITE}/llms-full.txt (everything in one file).`,
    "",
    ...lines,
    "",
  ].join("\n");
}

function llmsIndex(root: string): string {
  const sections = SECTIONS.map(({ title, slugs }) => {
    const items = slugs.map((slug) => {
      const page = readPage(root, slug);
      return `- [${page.title}](${url(slug)}): ${page.description}`;
    });
    return [`## ${title}`, "", ...items].join("\n");
  });
  const errors = Object.entries(ERROR_CODES).map(
    ([code, info]) => `- [${code}](${url(`errors/${code}`)}): ${info.title}`,
  );
  return [
    "# Actor Kit",
    "",
    "> Actors on the edge: each actor is a Cloudflare Durable Object with synchronous reducer handlers, roles, per-role binary views, typed services through an outbox, durable timers, states with typed locals, domain events, and a journal with replay and restore. Packages: @actor-kit/core, worker, client, react, test, storybook, studio, studio-cli.",
    "",
    "For agents: define actors only with `setup()` and `kit.actor()`; handlers are synchronous and read time and randomness only through `ctx.now()`, `ctx.random()`, `ctx.id()`; every error and refusal carries a `code` with a page under /errors/. Each package also ships these docs in its `docs/` folder.",
    "",
    ...sections.flatMap((s) => [s, ""]),
    "## Upgrading",
    "",
    "- [Upgrading to 0.3](https://github.com/actor-kit/actor-kit/blob/main/docs/upgrading-0.3.md): one note per breaking change, with code before and after.",
    "",
    "## Errors",
    "",
    ...errors,
    "",
    "## Optional",
    "",
    `- [Everything in one file](${SITE}/llms-full.txt)`,
    "",
  ].join("\n");
}

function llmsFull(root: string): string {
  const pages = SECTIONS.flatMap(({ slugs }) => slugs).map((slug) => {
    const page = readPage(root, slug);
    return `# ${page.title}\n\nSource: ${url(slug)}\n\n${absoluteLinks(page.body)}\n`;
  });
  const upgrading = `# Upgrading to 0.3\n\n${absoluteLinks(
    readFileSync(join(root, "docs/upgrading-0.3.md"), "utf8")
      .replace(/^# .*\n/, "")
      .trim(),
  )}\n`;
  return [
    "# Actor Kit: the full documentation",
    "",
    `Generated from ${SITE} (index: ${SITE}/llms.txt).`,
    "",
    ...pages,
    upgrading,
    errorsReference(),
  ].join("\n");
}

/** Every generated file, path (relative to the repo root) → content. */
export function generateDocs(root: string): Map<string, string> {
  const files = new Map<string, string>();
  files.set(`${DOCS}/errors/index.md`, errorsIndex());
  for (const code of ERROR_CODE_LIST) files.set(`${DOCS}/errors/${code}.md`, errorPage(code));
  for (const [pkg, slugs] of Object.entries(PACKAGE_DOCS)) {
    files.set(`packages/${pkg}/docs/README.md`, packageIndex(pkg, slugs, root));
    for (const slug of slugs) files.set(`packages/${pkg}/docs/${fileName(slug)}`, packageDoc(root, slug));
  }
  const index = llmsIndex(root);
  const full = llmsFull(root);
  files.set("llms.txt", index);
  files.set("llms-full.txt", full);
  files.set("website/public/llms.txt", index);
  files.set("website/public/llms-full.txt", full);
  return files;
}
