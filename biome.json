{
  "$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "error"
      },
      "complexity": {
        "useLiteralKeys": "off"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useConst": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "files": {
    "includes": [
      "packages/actor-kit/src/**/*.ts",
      "packages/core/src/**/*.ts",
      "packages/worker/src/**/*.ts",
      "packages/client/src/**/*.ts",
      "packages/react/src/**/*.ts",
      "packages/test/src/**/*.ts",
      "packages/studio/src/**/*.ts",
      "tests/**/*.ts"
    ],
    "ignoreUnknown": true
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
