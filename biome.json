{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "complexity": {
        "useLiteralKeys": "off"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useConst": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "files": {
    "includes": [
      "packages/actor-kit/src/**/*.ts",
      "packages/core/src/**/*.ts",
      "packages/worker/src/**/*.ts",
      "packages/client/src/**/*.ts",
      "packages/react/src/**/*.ts",
      "packages/test/src/**/*.ts",
      "packages/studio/src/**/*.ts",
      "packages/studio/ui/src/**/*.{ts,tsx}",
      "packages/studio-cli/src/**/*.ts",
      "packages/storybook/src/**/*.ts",
      "tests/**/*.ts",
      "scripts/**/*.mts",
      "!**/.wrangler"
    ],
    "ignoreUnknown": true
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "plugins": [
    "./packages/worker/biome/no-nondeterminism.grit"
  ]
}
