{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-core.schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "mutate": [
    "packages/core/src/**/*.ts",
    "packages/worker/src/runtime/**/*.ts",
    "packages/worker/src/message.ts",
    "packages/worker/src/define.ts",
    "packages/worker/src/identity.ts",
    "packages/worker/src/auth.ts",
    "packages/worker/src/ref.ts",
    "packages/client/src/**/*.ts",
    "packages/react/src/**/*.ts",
    "packages/test/src/**/*.ts",
    "!packages/*/src/index.ts",
    "!packages/worker/src/actor.ts"
  ],
  "reporters": ["clear-text", "html"],
  "thresholds": {
    "high": 90,
    "low": 70,
    "break": 60
  },
  "concurrency": 2,
  "timeoutMS": 30000
}
